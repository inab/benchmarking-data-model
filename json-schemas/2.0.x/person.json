{
	"$id": "https://w3id.org/openebench/scientific-schemas/2.0/Person",
	"$schema": "https://json-schema.org/draft/2019-09/schema",
	"title": "Person concept (OpenEBench Benchmarking Data Model schemas)",
	"$comment": "allOf and placeholders inspired by https://stackoverflow.com/a/24365393",
	"allOf": [
		{
			"$comment": "It declares _canonical_id, _metadata, _revision, _license, ___provenance___",
			"$ref": "_shared#/definitions/CommonKeys"
		},
		{
			"$comment": "Declaration of links",
			"$ref": "_shared#/definitions/LinksProp"
		}
	],
	"type": "object",
	"properties": {
		"_id": {
			"$ref": "_shared#/definitions/PersonCanonicalId"
		},
		"_schema": {
			"title": "The JSON schema absolute URI. It must match the value of '$id' in the JSON schema",
			"type": "string",
			"format": "uri",
			"enum": [ "https://w3id.org/openebench/scientific-schemas/2.0/Person" ]
		},
		
		"links": {
			"$comment": "Placeholder covered by _shared#/definitions/LinksProp",
			"title": "Optional links related to the contact"
		},
		
		"givenName": {
			"title": "First / given name",
			"type": "string",
			"minLength": 1
		},
		"surname": {
			"title": "Surname(s)",
			"type": "string",
			"minLength": 1
		},
		"email": {
			"title": "The e-mail address(es) of the contact",
			"type": "string",
			"minLength": 1,
			"format": "email"
		},
		"notes": {
			"title": "Comments about the contact",
			"type": "string"
		},
		"___privileges___" : {
			"title": "The roles assigned to this person",
			"type": "array",
  			"items": {
				"type": "object",
				"properties": {
					"role": {
						"title": "The role assigned to the person",
						"type": "string",
						"enum":  [ "owner", "manager", "contributor", "manager", "contributor", "evaluator", "supervisor", "public" ]
					},
					"community_id": {
						"title": "The community the role is assigned to",
						"type": "string",
						"foreign_keys": [
							{
								"schema_id": "Community",
								"members": [ "." ]
							}
						],
						"minLength": 7
					},
					"benchmarking_event_id": {
						"title": "The benchmarking event the role is assigned to",
						"type": "string",
						"foreign_keys": [
							{
								"schema_id": "BenchmarkingEvent",
								"members": [ "." ]
							}
						],
						"minLength": 1
					},
					"challenge_id": {
						"title": "The challenge the role is assigned to",
						"type": "string",
						"foreign_keys": [
							{
								"schema_id": "Challenge",
								"members": [ "." ]
							}
						],
						"minLength": 1
					}
				},
				"required": ["role"],
				"unevaluatedProperties": false,
				"oneOf": [
					{
						"required": ["role", "community_id"],
						"allOf": [
							{
								"not": {
									"required": ["benchmarking_event_id"]
								}
							},
							{
								"not": {
									"required": ["challenge_id"]
								}
							},
							{
								"properties": {
									"role": {
										"type": "string",
										"enum": [ "owner", "public" ]
									}
								}
							}
						]
					},
					{
						"required": ["role", "benchmarking_event_id"],
						"allOf": [
							{
								"not": {
									"required": ["community_id"]
								}
							},
							{
								"not": {
									"required": ["challenge_id"]
								}
							},
							{
								"properties": {
									"role": {
										"type": "string",
										"enum": [ "manager", "contributor" ]
									}
								}
							}
						]
					},
					{
						"required": ["role", "challenge_id"],
						"allOf": [
							{
								"not": {
									"required": ["community_id"]
								}
							},
							{
								"not": {
									"required": ["benchmarking_event_id"]
								}
							},
							{
								"properties": {
									"role": {
										"type": "string",
										"enum": [ "manager", "contributor", "evaluator", "supervisor" ]
									}
								}
							}
						]
					}
				]
			}
		}
	},
	"unevaluatedProperties": false,
	"required": [
		"_id",
		"_schema",
		"email"
	],
	"primary_key": ["_id"],
	"dependencies": {}
}
